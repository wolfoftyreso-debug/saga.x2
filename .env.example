# Vercel Marketplace Neon — injected automatically after the Neon integration
# is connected to the Vercel project. Keep this server-only.
DATABASE_URL=

# Vercel Blob — injected automatically after a private Blob store is connected.
# Originals and private attachments never go through a public browser token.
BLOB_READ_WRITE_TOKEN=

# Sign in with Vercel. Create the app in Vercel Team Settings → Apps and add
# both localhost and the production callback URL: /api/auth/callback.
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Vercel AI Gateway. Use a dedicated, budgeted AI_GATEWAY_API_KEY locally and
# as the initial Production rollout baseline. SAGA's Function-runtime OIDC
# bridge is implemented, but do not remove this baseline until the live smoke
# in docs/SAGA_AI_GATEWAY_RUNBOOK.md has passed. Do not set
# VERCEL_OIDC_TOKEN manually.
AI_GATEWAY_API_KEY=
# Do not set VERCEL_OIDC_TOKEN manually.

# Optional pinned image model for SAGA's private AI media worker. It must stay
# in the OpenAI GPT Image family because the worker requires a private PNG
# response through Vercel AI Gateway; it never accepts a direct OpenAI key.
# SAGA_IMAGE_GATEWAY_MODEL=openai/gpt-image-1.5

# Optional pinned text model for the transient Brand Onboarding adviser. It
# must be an openai/-model in Vercel AI Gateway. The adviser never saves,
# publishes, spends or falls back to a direct provider key.
# SAGA_BRAND_ADVISOR_GATEWAY_MODEL=openai/gpt-5.4-mini

# Set this only for a local production-like check. Vercel sets VERCEL itself.
# VERCEL_ONLY=1

# SAGA News Core — optional Guardian Open Platform connector. Keep this
# server-only. Guardian discovery is metadata-only until the deployment has
# appropriate commercial/AI rights; RSS/Atom and GDELT require no API key.
GUARDIAN_OPEN_PLATFORM_API_KEY=
# Guardian remains off unless commercial/AI rights have been approved for the
# exact use case. The preflight rejects a half-configured Guardian connector.
SAGA_NEWS_GUARDIAN_COMMERCIAL_LICENSED=

# Optional Content Engine test-lab model overrides. Keep the matching Gateway
# namespace; logical provider xai uses spacexai/ for Grok. The browser can choose
# only a logical provider, never an arbitrary model ID or API key.
# AI_GATEWAY_LAB_OPENAI_MODEL=openai/...
# AI_GATEWAY_LAB_ANTHROPIC_MODEL=anthropic/...
# AI_GATEWAY_LAB_GOOGLE_MODEL=google/...
# AI_GATEWAY_LAB_XAI_MODEL=spacexai/grok-4.1-fast-non-reasoning

# Development only: exact additional LAN origins allowed to load Next.js dev
# assets. `localhost` and `127.0.0.1` are always allowed; do not use `*`.
# NEXT_DEV_ALLOWED_ORIGINS=192.168.1.197

# Protects Vercel Cron routes from unauthorised calls.
CRON_SECRET=

# Content Studio — social publishing (server-only; never prefix these values
# with NEXT_PUBLIC_). Tokens are encrypted before they are stored.
# Generate once and retain safely: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Exact public root registered in Meta/LinkedIn OAuth settings. HTTPS is required
# in production; http://localhost:3000 is accepted only for local development.
SOCIAL_OAUTH_BASE_URL=

# Meta: Facebook Pages and Instagram Professional accounts only. Configure the
# callback URLs /api/social/connections/facebook_page/callback and
# /api/social/connections/instagram_professional/callback in the Meta app.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
# Facebook Login uses graph.facebook.com to discover Pages. Leave the Instagram
# host at graph.facebook.com for the connected-Page flow, or set it to
# https://graph.instagram.com only when using a compatible Instagram Login token.
META_INSTAGRAM_GRAPH_BASE_URL=https://graph.facebook.com
# Optional override. Keep least privilege and request only approved app scopes.
# META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish

# LinkedIn. Register /api/social/connections/linkedin/callback as an exact
# HTTPS redirect URL and ensure the app has w_member_social (and optionally
# w_organization_social if organisation publishing is added later).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202602
# LINKEDIN_OAUTH_SCOPES=r_liteprofile,w_member_social
